ght_on\n    if light_on == 0:\n        light_on = 1\n        pins.digital_write_pin(DigitalPin.P8, 1)\n        basic.show_icon(IconNames.HEART)\n    else:\n        light_on = 0\n        pins.digital_write_pin(DigitalPin.P8, 0)\n        basic.show_icon(IconNames.ASLEEP)\n    basic.pause(300)\n    basic.clear_screen()\n\n# ===== 按键 B：切换布防模式 =====\ndef on_button_pressed_b():\n    global armed\n    if armed == 0:\n        armed = 1\n        basic.show_icon(IconNames.SQUARE)   # 布防指示\n    else:\n        armed = 0\n        basic.show_icon(IconNames.NO)       # 撤防指示\n    basic.pause(300)\n    basic.clear_screen()\n\n# ===== 事件绑定 =====\ninput.on_button_pressed(Button.A, on_button_pressed_a)\ninput.on_button_pressed(Button.B, on_button_pressed_b)\nbasic.forever(on_forever)\n","pxt.json":"{\n    \"name\": \"王子铭小组-Micro:bit智能小屋\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\",\n        \"pxt-DHT11_DHT22\": \"github:alankrantas/pxt-dht11_dht22#v0.0.3\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"main.py\"\n    ],\n    \"preferredEditor\": \"blocksprj\"\n}\n"}},{"timestamp":1791023959707,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"_6gKWFKD8N2`f.C.Gku:\">light_on</variable><variable id=\"Gpd6:.}7yh$4TOZYo,k;\">armed</variable><variable id=\"uXJDpK/S)lBS1f)cZ2pE\">person</variable></variables><block type=\"pxt-on-start\" x=\"2\" y=\"-363\"><statement name=\"HANDLER\"><block type=\"variables_set\"><field name=\"VAR\" id=\"_6gKWFKD8N2`f.C.Gku:\">light_on</field><value name=\"VALUE\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value><next><block type=\"variables_set\"><field name=\"VAR\" id=\"Gpd6:.}7yh$4TOZYo,k;\">armed</field><value name=\"VALUE\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></val